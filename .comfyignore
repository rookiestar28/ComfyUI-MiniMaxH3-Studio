# Comfy Registry includes product and developer sources. Keep maintainer-only records,
# local environments and runtime media outside that public boundary.
.planning/
reference/
.github/
AGENTS.md
ROADMAP.md
.secrets.baseline
tests/TEST_SOP.md
tests/E2E_TESTING_NOTICE.md
tests/E2E_TESTING_SOP.md
tests/CI_TEST_MATRIX.md

# Local environments, build output, caches, and logs.
.venv/
.venv-*/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.log

# Private or heavyweight runtime material must never be published.
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.onnx
# Synthetic tracked test media is a required developer input; arbitrary runtime media stays out.
*.mp4
!frontend/tests/fixtures/**/*.mp4
!tests/fixtures/**/*.mp4
*.mov
*.avi
*.webm
*.wav
!tests/fixtures/**/*.wav
!tests/fixtures/**/*.bin
*.mp3
*.flac
