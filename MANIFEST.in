# Public source distribution includes developer tests and their tracked support inputs.
# Private planning/evidence and generated dependency/cache material remain excluded.
include README.md
# IMPORTANT: root public files need explicit selectors; grafts cover only directory inputs.
include RELEASE_NOTES.md
include LICENSE
include NOTICE
include MANIFEST.in
include .comfyignore
include .gitignore
# IMPORTANT: root selectors must include Git attributes or issued-sdist rebuilds lose required bytes.
include .gitattributes
include public-source-inventory.json
include pyproject.toml
include __init__.py
include .pre-commit-config.yaml
include .github/workflows/ci.yml
include .github/workflows/publish.yml

# The backend supplies a fresh public-only snapshot. Include every tracked input,
# regardless of suffix; the independent archive audit still verifies required coverage.
graft comfyui_h3_context
graft docs
graft examples
graft workflows
graft subgraphs
graft assets
graft tests
graft frontend
graft scripts
graft governance
graft compatibility
graft requirements

prune .planning
prune reference
prune build
prune dist
prune .venv
prune .venv-wsl
prune comfyui_h3_context.egg-info

global-exclude AGENTS.md ROADMAP.md
global-exclude *.py[cod]
global-exclude __pycache__/*
global-exclude .pytest_cache/*
global-exclude .mypy_cache/*
global-exclude .ruff_cache/*
global-exclude comfyui_h3_context.egg-info/*
global-exclude *.log
global-exclude .secrets.baseline
prune frontend/node_modules
prune frontend/test-results
prune frontend/playwright-report
