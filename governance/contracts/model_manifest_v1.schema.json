{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/model_manifest_v1.schema.json",
  "title": "H3 explicit model-family manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "manifest_id", "backend_family", "adapter_id", "adapter_version",
    "model_id", "model_digest", "checkpoint_fingerprint", "detected_family",
    "clip_type", "tokenizer_processor", "generation_weights_complete", "capabilities",
    "structured_output_schema", "parser_path", "runtime", "cancellation", "license",
    "host_profile", "evidence_level", "approved", "notes", "server_version"
  ],
  "properties": {
    "schema": {"const": "h3.model.manifest.v1"},
    "manifest_id": {"$ref": "#/$defs/Code"},
    "backend_family": {"enum": ["comfyui_native", "ollama"]},
    "adapter_id": {"$ref": "#/$defs/Code"},
    "adapter_version": {"$ref": "#/$defs/Version"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "model_digest": {"$ref": "#/$defs/Fingerprint"},
    "checkpoint_fingerprint": {"$ref": "#/$defs/Fingerprint"},
    "detected_family": {"$ref": "#/$defs/Code"},
    "clip_type": {"type": ["string", "null"]},
    "tokenizer_processor": {"$ref": "#/$defs/Code"},
    "generation_weights_complete": {"type": "boolean"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["text_generation", "vision", "video", "audio", "structured_output"]}},
    "structured_output_schema": {"$ref": "#/$defs/Code"},
    "parser_path": {"$ref": "#/$defs/Code"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "dtype", "offload", "max_context_tokens", "max_output_tokens", "max_media_items", "limits"],
      "properties": {
        "device": {"type": "string"},
        "dtype": {"$ref": "#/$defs/Code"},
        "offload": {"$ref": "#/$defs/Code"},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_media_items": {"type": "integer", "minimum": 1},
        "limits": {"type": "object"}
      }
    },
    "cancellation": {"enum": ["qualified", "unqualified", "unsupported"]},
    "license": {"$ref": "#/$defs/Code"},
    "host_profile": {"$ref": "#/$defs/Code"},
    "evidence_level": {"enum": ["official", "framework_reference", "community_recommended", "experimental", "modified"]},
    "approved": {"type": "boolean"},
    "notes": {"type": "string", "maxLength": 2048},
    "server_version": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"}
  },
  "$defs": {
    "Code": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
    "Version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"},
    "Fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
