{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/official_context_ir_v1.schema.json",
  "title": "MiniMax H3-Context-IR request projection v1",
  "description": "Pinned public request projection; it is not the private Context-IR implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "content", "duration", "ratio"],
  "properties": {
    "model": {"const": "MiniMax-H3"},
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/ContentItem"}
    },
    "duration": {"type": "integer", "minimum": 4, "maximum": 15},
    "ratio": {
      "type": "string",
      "enum": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]
    }
  },
  "$defs": {
    "ContentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "image_url", "video_url", "audio_url"]
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 7000},
        "image_url": {"$ref": "#/$defs/URLValue"},
        "video_url": {"$ref": "#/$defs/URLValue"},
        "audio_url": {"$ref": "#/$defs/URLValue"},
        "role": {
          "type": "string",
          "enum": [
            "first_frame",
            "last_frame",
            "reference_image",
            "reference_video",
            "reference_audio"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "text"}}},
          "then": {"required": ["text"], "not": {"required": ["role"]}}
        },
        {
          "if": {"properties": {"type": {"const": "image_url"}}},
          "then": {"required": ["image_url", "role"]}
        },
        {
          "if": {"properties": {"type": {"const": "video_url"}}},
          "then": {"required": ["video_url", "role"]}
        },
        {
          "if": {"properties": {"type": {"const": "audio_url"}}},
          "then": {"required": ["audio_url", "role"]}
        }
      ]
    },
    "URLValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    }
  }
}
