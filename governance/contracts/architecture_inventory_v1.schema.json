{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/architecture_inventory_v1.schema.json",
  "title": "ComfyUI H3 context M19 architecture inventory",
  "description": "Deterministic, content-free architecture baseline for the M19 modularity chain. Every module carries its declared layer, its coupling, the tests found to own it and whether a cohort may move it. Import edges carry the kind that reaches them, so a cycle records what closes it rather than being counted or ignored. Three things are refused outright rather than reported as a number: a forbidden pure-core dependency, a layer inversion under the declared model, and a cyclic component that closes through module-level imports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "modules",
    "fingerprint",
    "forbidden_imports",
    "layer_inversions"
  ],
  "properties": {
    "schema": { "const": "h3-context-architecture-inventory/1" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "modules": {
      "description": "One row per module, sorted and unique by module name.",
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/module" }
    },
    "deferred_edges": {
      "description": "Intra-package imports that never execute at import time. Each is a boundary somebody already drew by hand.",
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/edge" }
    },
    "cycles": {
      "description": "Cyclic components in the static import graph, each recording the edge kinds that keep it closed.",
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/cycle" }
    },
    "surfaces": {
      "description": "Every authority that declares what this package exposes, with how much each shares with the others.",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/surface" }
    },
    "bindings": {
      "description": "Acceptance-baseline rows a cohort would have to re-record, sorted and unique by binding_id.",
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/binding" }
    },
    "cohorts": {
      "description": "Frozen successor scopes. A cohort may never name a module whose owning test is unresolved.",
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/cohort" }
    },
    "forbidden_imports": {
      "description": "Pure-core dependencies on a host, runtime or network stack. The record refuses to hold one, so this is always empty.",
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "layer_inversions": {
      "description": "Imports from a lower layer to a higher one under the declared model. Refused the same way, so always empty.",
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "edge_kind_totals": {
      "description": "How many edges each kind carries, across the whole package.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module_level": { "type": "integer", "minimum": 0 },
        "function_local": { "type": "integer", "minimum": 0 },
        "type_checking": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "module_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._ -]*(/[A-Za-z0-9._-][A-Za-z0-9._ -]*)*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:/@+-]*$"
    },
    "layer": { "enum": ["core", "adapters", "node_ui"] },
    "edge_kind": { "enum": ["module_level", "function_local", "type_checking"] },
    "owner_rule": {
      "enum": [
        "direct_module",
        "submodule_as_name",
        "importlib_literal",
        "hub_symbol",
        "qualification_subject"
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "layer",
        "lines",
        "inbound",
        "outbound",
        "owning_tests",
        "owning_rules",
        "disposition",
        "reasons"
      ],
      "properties": {
        "module": { "$ref": "#/$defs/module_name" },
        "layer": { "$ref": "#/$defs/layer" },
        "lines": { "type": "integer", "minimum": 0 },
        "inbound": { "type": "integer", "minimum": 0, "maximum": 256 },
        "outbound": { "type": "integer", "minimum": 0, "maximum": 256 },
        "owning_tests": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "owning_rules": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/owner_rule" }
        },
        "disposition": { "enum": ["movable", "need_evidence"] },
        "reasons": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "kinds"],
      "properties": {
        "source": { "$ref": "#/$defs/module_name" },
        "target": { "$ref": "#/$defs/module_name" },
        "kinds": {
          "description": "A deferred edge never carries module_level; that is what makes it deferred.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "enum": ["function_local", "type_checking"] }
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "closes_through", "runtime_cycle"],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/module_name" }
        },
        "closes_through": {
          "description": "module_level cannot appear: a component that stays closed at import time is refused.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "enum": ["function_local", "type_checking"] }
        },
        "runtime_cycle": { "const": false }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "authority", "declared", "overlaps"],
      "properties": {
        "surface_id": { "$ref": "#/$defs/identifier" },
        "authority": { "$ref": "#/$defs/relative_path" },
        "declared": { "type": "integer", "minimum": 0 },
        "overlaps": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["other", "shared"],
            "properties": {
              "other": { "$ref": "#/$defs/identifier" },
              "shared": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "kind", "path", "owner"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["public_python_abi", "criterion"] },
        "path": { "$ref": "#/$defs/relative_path" },
        "owner": { "$ref": "#/$defs/identifier" }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "successor", "modules", "reason"],
      "properties": {
        "cohort_id": { "$ref": "#/$defs/identifier" },
        "successor": { "$ref": "#/$defs/identifier" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/module_name" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
