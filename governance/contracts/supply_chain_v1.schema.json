{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h3-context://contracts/supply_chain_v1.schema.json",
  "title": "ComfyUI-MiniMaxH3-Context Supply Chain Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "frontend_lock_package_count",
    "license_inventory",
    "spdx",
    "build_inputs",
    "runtime_entries",
    "reference_assets"
  ],
  "properties": {
    "schema": {"const": "h3-context-supply-chain/1"},
    "version": {"const": 1},
    "frontend_lock_package_count": {"const": 156},
    "license_inventory": {"$ref": "#/$defs/digest_ref"},
    "spdx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version", "package_count"],
      "properties": {
        "path": {"const": "governance/contracts/sbom.spdx.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"const": "SPDX-2.3"},
        "package_count": {"const": 172}
      }
    },
    "build_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/file"}
    },
    "runtime_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "reference_assets": {"const": "excluded_not_build_inputs_or_artifact_members"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 104857600}
      }
    }
  }
}
