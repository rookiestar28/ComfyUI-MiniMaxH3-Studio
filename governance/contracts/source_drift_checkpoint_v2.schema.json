{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/source_drift_checkpoint_v2.schema.json",
  "title": "H3 Source Drift Checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "retrieved_at",
    "disposition",
    "product_scope",
    "non_equivalence_preserved",
    "assisted_defaults_authorized",
    "assisted_profiles",
    "assisted_authoring",
    "supported_host_qualified",
    "latest_host_qualified",
    "native_prompt_boundary",
    "autogrow_path_basis",
    "presentation_label_basis",
    "fidelity_scorecard_fingerprint",
    "surfaces",
    "paid_calls",
    "model_executions",
    "media_executions",
    "provider_executions",
    "spend_microusd",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "h3.source_drift_checkpoint.v2"},
    "version": {"const": "2.0.0"},
    "retrieved_at": {"const": "2026-08-10T00:39:00+08:00"},
    "disposition": {"const": "PASS_WITH_BLOCKED_DRIFT"},
    "product_scope": {"const": "MANUAL_ONLY_SCOPED"},
    "non_equivalence_preserved": {"const": true},
    "assisted_defaults_authorized": {"const": false},
    "assisted_profiles": {
      "type": "array",
      "prefixItems": [
        {"const": "ollama.local"},
        {"const": "openai.remote"},
        {"const": "gemini.remote"},
        {"const": "anthropic.remote"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "assisted_authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "selected", "ready", "authorized_for_this_action", "defaulted"],
      "properties": {
        "available": {"const": true},
        "selected": {"const": false},
        "ready": {"const": false},
        "authorized_for_this_action": {"const": false},
        "defaulted": {"const": false}
      }
    },
    "supported_host_qualified": {"const": true},
    "latest_host_qualified": {"const": false},
    "native_prompt_boundary": {"const": "STRING"},
    "autogrow_path_basis": {"const": "fully_qualified_zero_based"},
    "presentation_label_basis": {"const": "one_based"},
    "fidelity_scorecard_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "surfaces": {
      "type": "array",
      "minItems": 18,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/surface"}
    },
    "paid_calls": {"type": "array", "maxItems": 0},
    "model_executions": {"type": "array", "maxItems": 0},
    "media_executions": {"type": "array", "maxItems": 0},
    "provider_executions": {"type": "array", "maxItems": 0},
    "spend_microusd": {"const": 0},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 128}
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "group",
        "official_url",
        "retrieved_at",
        "expected_identity",
        "observed_identity",
        "material",
        "disposition",
        "affected_seams",
        "requalification_owners"
      ],
      "properties": {
        "surface_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
        "group": {
          "enum": [
            "minimax_repository",
            "minimax_model",
            "minimax_guides",
            "minimax_api",
            "comfyui_core",
            "comfyui_frontend",
            "comfyui_native_h3",
            "ollama_docs",
            "ollama_server",
            "ollama_python_client",
            "m14_evidence"
          ]
        },
        "official_url": {"type": "string", "format": "uri", "maxLength": 512},
        "retrieved_at": {"const": "2026-08-10T00:39:00+08:00"},
        "expected_identity": {
          "type": "string",
          "pattern": "^(git|gitblob):[0-9a-f]{40}$|^sha256:[0-9a-f]{64}$"
        },
        "observed_identity": {
          "type": "string",
          "pattern": "^(git|gitblob):[0-9a-f]{40}$|^sha256:[0-9a-f]{64}$"
        },
        "material": {"type": "boolean"},
        "disposition": {
          "enum": [
            "EXACT_MATCH",
            "ADDITIVE_NON_SUBSTITUTING",
            "BLOCKED_PENDING_REQUALIFICATION"
          ]
        },
        "affected_seams": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_.:-]+$", "maxLength": 128}
        },
        "requalification_owners": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 128}
        }
      }
    }
  }
}
