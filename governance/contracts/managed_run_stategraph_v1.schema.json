{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/managed_run_stategraph_v1.schema.json",
  "title": "ComfyUI H3 context ManagedRun stategraph",
  "description": "Deterministic, content-free projection of the ManagedRun transition table: the states a run may hold, the terminal states, the ordered callback phases, and every trigger with the states it leaves, the state it reaches and the guard it must satisfy. It is generated from the machine definition, so it cannot describe a transition the code does not take.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "initial", "states", "final", "phases", "transitions"],
  "properties": {
    "schema": { "const": "h3.context.managed_run_stategraph.v1" },
    "initial": { "$ref": "#/$defs/name" },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "final": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "source", "target", "guard"],
      "properties": {
        "trigger": { "$ref": "#/$defs/name" },
        "source": { "$ref": "#/$defs/name" },
        "target": { "$ref": "#/$defs/name" },
        "guard": {
          "description": "The named invariant this transition must satisfy, or null when it has none. A transition that names a guard is refused when no implementation is supplied, so a null here is a claim that none is needed.",
          "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }]
        }
      }
    }
  }
}
