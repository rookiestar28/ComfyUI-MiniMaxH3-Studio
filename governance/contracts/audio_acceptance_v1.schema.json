{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/audio_acceptance_v1.schema.json",
  "title": "H3 audio perception acceptance v1",
  "type": "object",
  "required": ["schema", "plan_id", "plan_fingerprint", "status", "candidate_receipts", "family_summaries", "unsupported_capabilities", "executable_candidate_ids", "fallback_used", "optional_dependencies_absent", "bounded_skips", "limitations"],
  "properties": {
    "schema": { "const": "h3.audio.acceptance.v1" },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "plan_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "status": { "enum": ["qualified", "rejected", "unsupported_research"] },
    "candidate_receipts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/candidateReceipt" } },
    "family_summaries": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/familySummary" } },
    "unsupported_capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "executable_candidate_ids": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
    "fallback_used": { "type": "boolean", "const": false },
    "optional_dependencies_absent": { "type": "boolean", "const": true },
    "bounded_skips": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
    "limitations": { "type": "array", "maxItems": 64, "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capability": { "type": "string", "enum": ["source_clock", "channels", "sample_rate", "gaps", "overlap", "video_audio_ownership", "speech", "multilingual_dialogue", "silence", "noise", "music", "ambience", "sfx", "clipping", "corruption", "adversarial_metadata"] },
    "disposition": { "enum": ["qualified", "rejected", "unavailable", "unsupported"] },
    "candidateReceipt": {
      "type": "object",
      "required": ["schema", "candidate_id", "family", "declared_disposition", "effective_disposition", "capabilities", "missing_required_metrics", "failed_checks", "bounded_skips", "limitation", "executable"],
      "properties": {
        "schema": { "const": "h3.audio.acceptance.v1" },
        "candidate_id": { "type": "string" },
        "family": { "enum": ["comfyui_native", "ollama", "specialist"] },
        "declared_disposition": { "$ref": "#/$defs/disposition" },
        "effective_disposition": { "$ref": "#/$defs/disposition" },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
        "missing_required_metrics": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        "failed_checks": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        "bounded_skips": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        "limitation": { "type": "string" },
        "executable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "familySummary": {
      "type": "object",
      "required": ["schema", "family", "candidate_ids", "executable_candidate_ids", "dispositions"],
      "properties": {
        "schema": { "const": "h3.audio.acceptance.v1" },
        "family": { "enum": ["comfyui_native", "ollama", "specialist"] },
        "candidate_ids": { "type": "array", "items": { "type": "string" } },
        "executable_candidate_ids": { "type": "array", "items": { "type": "string" } },
        "dispositions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/disposition" } }
      },
      "additionalProperties": false
    }
  }
}
