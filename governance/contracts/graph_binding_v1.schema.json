{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfyui-h3-context.invalid/schemas/graph-binding-v1.json",
  "title": "H3 Context visible graph binding",
  "type": "object",
  "required": ["schema", "fixture_id", "task_modes", "nodes", "edges", "anchors", "children", "transparent"],
  "properties": {
    "schema": { "const": "h3.context.graph.binding.v1" },
    "fixture_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "task_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "object" } },
    "edges": { "type": "array", "maxItems": 256, "items": { "type": "object" } },
    "anchors": { "type": "array", "maxItems": 32, "items": { "type": "object" } },
    "children": { "type": "array", "maxItems": 16, "items": { "type": "object" } },
    "transparent": { "type": "boolean" }
  },
  "additionalProperties": false
}
