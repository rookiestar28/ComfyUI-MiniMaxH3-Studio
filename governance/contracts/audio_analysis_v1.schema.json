{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/audio_analysis_v1.schema.json",
  "title": "H3 bounded audio analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "status", "complete", "selected_asset_ids", "analyzed_sample_count", "observations", "diagnostics"],
  "properties": {
    "schema": {"const": "h3.audio.analysis.v1"},
    "batch_id": {"$ref": "#/$defs/identifier"},
    "status": {"enum": ["complete", "partial", "empty", "corrupt", "unsupported"]},
    "complete": {"type": "boolean"},
    "selected_asset_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "analyzed_sample_count": {"type": "integer", "minimum": 0, "maximum": 10000000000},
    "observations": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/observation"}},
    "diagnostics": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "seconds"],
      "properties": {
        "raw": {"type": "string", "minLength": 1, "maxLength": 64},
        "seconds": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail", "severity"],
      "properties": {
        "kind": {"enum": ["missing_source", "low_confidence", "ambiguous", "conflicting", "unsupported", "unintelligible", "truncated", "stale"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 4096},
        "severity": {"enum": ["info", "warning", "error", "fatal"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id", "asset_id", "span", "start", "end"],
      "properties": {
        "kind": {"const": "media_asset"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "asset_id": {"$ref": "#/$defs/identifier"},
        "span": {"type": ["string", "null"], "maxLength": 4096},
        "start": {"$ref": "#/$defs/time"},
        "end": {"$ref": "#/$defs/time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "claim", "origin", "support", "provenance", "confidence", "uncertainties"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "claim": {"type": "string", "minLength": 1, "maxLength": 4096},
        "origin": {"const": "observed"},
        "support": {"enum": ["supported", "uncertain"]},
        "provenance": {
          "type": "object",
          "required": ["source", "provider", "evidence_level", "provider_version", "source_revision"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "provider": {"const": "local"},
            "evidence_level": {"enum": ["official", "framework_reference", "community_recommended", "experimental", "modified"]},
            "provider_version": {"type": "string", "minLength": 1},
            "source_revision": {"type": "string", "minLength": 1}
          }
        },
        "confidence": {"type": ["string", "null"]},
        "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/uncertainty"}}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "asset_id", "kind", "language", "speaker_hint", "evidence"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/identifier"},
        "asset_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["transcript", "speaker", "voice", "music", "ambience", "sfx"]},
        "language": {"type": ["string", "null"], "maxLength": 64},
        "speaker_hint": {"type": ["string", "null"], "maxLength": 128},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "severity": {"enum": ["info", "warning", "error", "fatal"]}
      }
    }
  }
}
