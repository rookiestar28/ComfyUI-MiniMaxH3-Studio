{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/resource_runtime_v1.schema.json",
  "title": "H3 bounded resource runtime result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "complete", "receipt", "diagnostics"],
  "properties": {
    "schema": {"const": "h3.resource.runtime.v1"},
    "status": {"enum": ["complete", "partial", "stale", "cancelled", "timed_out", "memory_exceeded", "budget_exceeded", "concurrency_exceeded", "failed"]},
    "complete": {"type": "boolean"},
    "receipt": {"$ref": "#/$defs/receipt"},
    "diagnostics": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation_id", "status", "cache_state", "elapsed_seconds", "peak_memory_bytes", "output_bytes", "output_items", "reservation_released", "cache_stored", "worker_started"],
      "properties": {
        "schema": {"const": "h3.resource.runtime.v1"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["complete", "partial", "stale", "cancelled", "timed_out", "memory_exceeded", "budget_exceeded", "concurrency_exceeded", "failed"]},
        "cache_state": {"enum": ["disabled", "miss", "hit", "stale", "not_written"]},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "output_items": {"type": "integer", "minimum": 0},
        "reservation_released": {"const": true},
        "cache_stored": {"type": "boolean"},
        "worker_started": {"type": "boolean"}
      }
    },
    "cache_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation_id", "contract_schema", "provider_id", "provider_version", "settings_fingerprint", "source_fingerprints"],
      "properties": {
        "schema": {"const": "h3.resource.runtime.v1"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "contract_schema": {"$ref": "#/$defs/identifier"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "provider_version": {"$ref": "#/$defs/identifier"},
        "settings_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "source_fingerprints": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/fingerprint"}}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "location"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error", "fatal"]},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "location": {"type": ["string", "null"], "maxLength": 256}
      }
    }
  }
}
