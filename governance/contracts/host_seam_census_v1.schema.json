{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/host_seam_census_v1.schema.json",
  "title": "ComfyUI H3 Context host seam census",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "seams"],
  "properties": {
    "schema": { "const": "h3.context.host_seam_census.v1" },
    "profile": { "const": "comfyui_host_seams_v1" },
    "seams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/seam" }
    }
  },
  "$defs": {
    "sourcePath": {
      "type": "string",
      "maxLength": 260,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+\\.(?:py|ts|tsx)$"
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_floor",
        "multiplier",
        "derived_ceiling",
        "absolute_ceiling"
      ],
      "properties": {
        "observed_floor": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "multiplier": { "type": "integer", "minimum": 1, "maximum": 16 },
        "derived_ceiling": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "absolute_ceiling": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "seam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "owner",
        "classification",
        "authority",
        "source_paths",
        "readiness_states",
        "cost_class",
        "bound"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
        },
        "layer": { "enum": ["frontend", "backend"] },
        "owner": { "$ref": "#/$defs/sourcePath" },
        "classification": {
          "enum": ["documented", "undocumented_but_observed"]
        },
        "authority": {
          "type": "string",
          "pattern": "^(?:official|observed)\\.[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourcePath" }
        },
        "readiness_states": {
          "oneOf": [
            {
              "prefixItems": [
                { "const": "absent" },
                { "const": "present_not_ready" },
                { "const": "ready" },
                { "const": "unavailable" }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            {
              "prefixItems": [
                { "const": "ready" },
                { "const": "unavailable" }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "cost_class": { "enum": ["constant", "targeted", "full_collection"] },
        "bound": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bound" }]
        }
      }
    }
  }
}
