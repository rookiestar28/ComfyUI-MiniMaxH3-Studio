{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/visual_acceptance_v1.schema.json",
  "title": "H3 visual perception acceptance v1",
  "type": "object",
  "required": [
    "schema",
    "plan_id",
    "plan_fingerprint",
    "status",
    "candidate_receipts",
    "family_summaries",
    "unsupported_capabilities",
    "executable_candidate_ids",
    "fallback_used",
    "optional_dependencies_absent",
    "bounded_skips",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "h3.visual.acceptance.v1" },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "plan_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "enum": ["qualified", "rejected", "unsupported_research"] },
    "candidate_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/candidate_receipt" }
    },
    "family_summaries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/family_summary" }
    },
    "unsupported_capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "executable_candidate_ids": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
    "fallback_used": { "const": false },
    "optional_dependencies_absent": { "const": true },
    "bounded_skips": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
    "limitations": { "type": "array", "maxItems": 64, "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "string",
      "enum": [
        "global_description",
        "ocr",
        "subjects_objects",
        "identity",
        "shots",
        "actions",
        "camera",
        "motion",
        "style",
        "edits",
        "timestamps",
        "confidence",
        "corruption",
        "adversarial_text"
      ]
    },
    "candidate_receipt": {
      "type": "object",
      "required": [
        "schema",
        "candidate_id",
        "family",
        "declared_disposition",
        "effective_disposition",
        "capabilities",
        "missing_required_metrics",
        "failed_checks",
        "bounded_skips",
        "limitation",
        "executable"
      ],
      "properties": {
        "schema": { "const": "h3.visual.acceptance.v1" },
        "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "family": { "enum": ["comfyui_native", "ollama", "specialist"] },
        "declared_disposition": { "enum": ["qualified", "rejected", "unavailable", "unsupported"] },
        "effective_disposition": { "enum": ["qualified", "rejected", "unavailable", "unsupported"] },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
        "missing_required_metrics": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        "failed_checks": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        "bounded_skips": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        "limitation": { "type": "string", "maxLength": 512 },
        "executable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "family_summary": {
      "type": "object",
      "required": ["schema", "family", "candidate_ids", "executable_candidate_ids", "dispositions"],
      "properties": {
        "schema": { "const": "h3.visual.acceptance.v1" },
        "family": { "enum": ["comfyui_native", "ollama", "specialist"] },
        "candidate_ids": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
        "executable_candidate_ids": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
        "dispositions": { "type": "object", "additionalProperties": { "enum": ["qualified", "rejected", "unavailable", "unsupported"] } }
      },
      "additionalProperties": false
    }
  }
}
