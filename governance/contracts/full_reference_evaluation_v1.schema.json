{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/full_reference_evaluation_v1.schema.json",
  "title": "H3 Full-Reference security and evaluation gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "corpus_id", "cases"],
  "properties": {
    "schema": {"const": "h3.full_reference.evaluation.v1"},
    "corpus_id": {"$ref": "#/$defs/identifier"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "kind"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["representative", "hostile"]},
        "profile": {"const": "h3_full_reference"},
        "task_mode": {"const": "ref2va"},
        "media": {"type": "array", "items": {"enum": ["image", "video", "audio"]}},
        "lanes": {"type": "array", "items": {"type": "string"}},
        "attack_vectors": {"type": "array", "items": {"type": "string"}},
        "expected_terminal_resource_status": {"type": "string"}
      }
    }
  }
}
