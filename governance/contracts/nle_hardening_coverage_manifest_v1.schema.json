{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/nle_hardening_coverage_manifest_v1.schema.json",
  "title": "ComfyUI H3 context NLE hardening coverage manifest",
  "description": "M25-21, generated by scripts/nle_hardening_manifest.py: the exact hardening coverage of the expanded browser NLE. Each of the 34 canonical M25-11 command rows of the M25-16 control coverage manifest (keyed by the backend command), each of the seven SidebarEditorUiInvariantV1 rows and each non-command action or import row carries three independently executable evidence IDs (accessibility, stress, recovery). A dimension is satisfied only by an `nle_hardening.<row>.<dimension>` observation recorded by exactly the passing test its evidence ID names; one shared run may serve many rows that way. UI rows are not commands and can never satisfy or inflate the command set. The manifest holds no result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "surface",
    "joined_sources",
    "fixtures",
    "dimensions",
    "command_rows",
    "ui_rows",
    "action_rows",
    "recovery_rows",
    "measurements"
  ],
  "properties": {
    "schema": { "const": "h3.context.nle_hardening_coverage_manifest.v1" },
    "version": { "const": 1 },
    "surface": { "const": "overlay_v1" },
    "joined_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_coverage_manifest_sha256",
        "sidebar_editor_ui_contract_sha256"
      ],
      "properties": {
        "control_coverage_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "sidebar_editor_ui_contract_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "stress", "render", "ui_stress"],
      "properties": {
        "smoke": { "const": "M25-16-overlay-v1-smoke" },
        "stress": { "const": "NLE-STRESS-V1" },
        "render": { "const": "NLE-STRESS-RENDER-V1" },
        "ui_stress": { "const": "UI-CONTRACT-STRESS-V1" }
      }
    },
    "dimensions": {
      "type": "array",
      "prefixItems": [
        { "const": "accessibility" },
        { "const": "stress" },
        { "const": "recovery" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "command_rows": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": { "$ref": "#/$defs/commandRow" }
    },
    "ui_rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/uiRow" }
    },
    "action_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/actionRow" }
    },
    "recovery_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/recoveryRow" }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/measurement" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "evidenceId": {
      "type": "string",
      "description": "The test file relative to frontend/tests, ::, and the fully expanded collected test title (describe ancestors separated by ' > '). The current runners must collect that concrete case without skip.",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^(?:e2e/journeys/[A-Za-z0-9_]+\\.spec\\.ts|[A-Za-z0-9_/]+\\.test\\.tsx?)::[^$]+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessibility_evidence_id",
        "stress_evidence_id",
        "recovery_evidence_id"
      ],
      "properties": {
        "accessibility_evidence_id": { "$ref": "#/$defs/evidenceId" },
        "stress_evidence_id": { "$ref": "#/$defs/evidenceId" },
        "recovery_evidence_id": { "$ref": "#/$defs/evidenceId" }
      }
    },
    "effectCounts": {
      "type": "object",
      "description": "Exact expected unrequested-effect counts of a navigation or lifecycle interaction. Required bounded read/abort/release calls are counted separately by the observation.",
      "additionalProperties": false,
      "required": ["command", "revision", "job", "output", "queue", "provider"],
      "properties": {
        "command": { "const": 0 },
        "revision": { "const": 0 },
        "job": { "const": 0 },
        "output": { "const": 0 },
        "queue": { "const": 0 },
        "provider": { "const": 0 }
      }
    },
    "subcase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subcase_id", "dimension", "evidence_id"],
      "properties": {
        "subcase_id": { "$ref": "#/$defs/identifier" },
        "dimension": { "enum": ["accessibility", "stress", "recovery"] },
        "evidence_id": { "$ref": "#/$defs/evidenceId" }
      }
    },
    "commandRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "operation_id",
        "control_selector",
        "role",
        "accessible_name",
        "recovery_injection",
        "evidence"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/identifier" },
        "operation_id": { "$ref": "#/$defs/identifier" },
        "control_selector": {
          "type": "string",
          "pattern": "^\\[data-h3-nle-control=\"[a-z_.]+\"\\]$"
        },
        "role": { "enum": ["button", "menuitem", "slider", "spinbutton", "combobox"] },
        "accessible_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recovery_injection": {
          "enum": [
            "response_loss",
            "stale_revision",
            "conflict_rebase",
            "cancellation",
            "source_replacement",
            "context_suspension",
            "backend_restart"
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "subcases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/subcase" }
        }
      }
    },
    "lifecycleState": {
      "enum": ["compact_ready", "expanded", "compact_unsupported", "unchanged"]
    },
    "uiRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id",
        "owned_selector",
        "role",
        "relationship",
        "lifecycle_before",
        "lifecycle_after",
        "close_reasons",
        "focus_targets",
        "fallback_vocabulary",
        "expected_effects",
        "retention_slots",
        "evidence"
      ],
      "properties": {
        "invariant_id": {
          "enum": [
            "global_shell_identity",
            "function_switch",
            "overlay_open",
            "duplicate_open",
            "overlay_close_return_focus",
            "overlay_unavailable_status",
            "view_destroy_cleanup"
          ]
        },
        "owned_selector": { "type": "string", "minLength": 3, "maxLength": 256 },
        "role": {
          "enum": ["navigation", "tablist", "dialog", "button", "status", "region"]
        },
        "relationship": { "type": "string", "minLength": 3, "maxLength": 256 },
        "lifecycle_before": { "$ref": "#/$defs/lifecycleState" },
        "lifecycle_after": { "$ref": "#/$defs/lifecycleState" },
        "close_reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "enum": [
              "explicit_close",
              "escape",
              "function_switch",
              "top_level_navigation",
              "capability_or_mount_failure",
              "view_destroy"
            ]
          }
        },
        "focus_targets": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 3, "maxLength": 256 },
          "minProperties": 1,
          "maxProperties": 6
        },
        "fallback_vocabulary": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": ["selected_source_only", "media_runtime_unavailable", "compact_unsupported"]
          }
        },
        "expected_effects": { "$ref": "#/$defs/effectCounts" },
        "retention_slots": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 14,
          "items": {
            "enum": [
              "navigation.function",
              "production.view",
              "production.anchor",
              "production.draft",
              "authoring.view",
              "authoring.draft",
              "nle.overlay",
              "nle.timeline",
              "nle.transport",
              "nle.track",
              "nle.insert",
              "nle.range",
              "nle.clip",
              "settings.view"
            ]
          }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "actionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "row_class",
        "authority_class",
        "control_selector",
        "evidence"
      ],
      "properties": {
        "row_id": { "$ref": "#/$defs/identifier" },
        "row_class": { "enum": ["import", "action"] },
        "authority_class": {
          "enum": [
            "output_action",
            "local_transport",
            "canonical_derived_effect",
            "deferred_unavailable"
          ]
        },
        "control_selector": {
          "anyOf": [
            { "type": "string", "minLength": 3, "maxLength": 256 },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "recoveryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seam_id", "injection", "injections_min", "evidence_id"],
      "properties": {
        "seam_id": { "$ref": "#/$defs/identifier" },
        "injection": {
          "enum": [
            "native_media_error",
            "canvas_context_loss",
            "follower_suspension",
            "response_loss",
            "view_release_mid_flight",
            "backend_restart",
            "non_allocation"
          ]
        },
        "injections_min": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evidence_id": { "$ref": "#/$defs/evidenceId" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_id", "scope", "unit", "threshold", "evidence_id"],
      "properties": {
        "measurement_id": { "$ref": "#/$defs/identifier" },
        "scope": {
          "enum": [
            "M25-16-overlay-v1-smoke",
            "NLE-STRESS-V1",
            "NLE-STRESS-RENDER-V1",
            "UI-CONTRACT-STRESS-V1"
          ]
        },
        "unit": { "enum": ["ratio", "ms", "bytes", "count", "frames"] },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": { "enum": ["<=", ">=", "=="] },
            "value": { "type": "number", "minimum": 0 }
          }
        },
        "evidence_id": { "$ref": "#/$defs/evidenceId" }
      }
    }
  }
}
