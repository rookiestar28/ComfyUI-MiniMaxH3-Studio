{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/source_ledger_v1.schema.json",
  "title": "H3 Context source, claim, unknown, and hypothesis ledger v1",
  "description": "A versioned, source-backed evidence ledger. It records provenance and drift policy without fetching or rewriting sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledger_id",
    "ledger_version",
    "updated_at",
    "sources",
    "records"
  ],
  "properties": {
    "schema": {"const": "h3-context-source-ledger/1"},
    "ledger_id": {"$ref": "#/$defs/identifier"},
    "ledger_version": {"$ref": "#/$defs/version"},
    "updated_at": {"$ref": "#/$defs/date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/source"}
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "official",
        "framework_reference",
        "community_recommended",
        "experimental",
        "modified"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "blocked",
        "open",
        "proposed",
        "rejected",
        "resolved",
        "superseded",
        "tested"
      ]
    },
    "drift_policy": {
      "type": "string",
      "enum": [
        "fail_on_change",
        "report_only",
        "revalidate",
        "source_maintainer_review"
      ]
    },
    "source_id_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "revision",
        "retrieved_at",
        "evidence_class",
        "canary"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "revision": {"$ref": "#/$defs/revision"},
        "retrieved_at": {"$ref": "#/$defs/date"},
        "evidence_class": {"$ref": "#/$defs/evidence_class"},
        "role": {"$ref": "#/$defs/identifier"},
        "local_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canary": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"canary": {"const": true}}},
          "then": {"required": ["local_path", "sha256"]}
        },
        {
          "if": {"properties": {"canary": {"const": false}}},
          "then": {"not": {"required": ["sha256"]}}
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "kind",
        "statement",
        "status",
        "evidence_class",
        "confidence",
        "source_ids",
        "owning_tests",
        "drift_policy",
        "affected_profiles"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["claim", "unknown", "hypothesis", "conflict"]},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"$ref": "#/$defs/status"},
        "evidence_class": {"$ref": "#/$defs/evidence_class"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "source_ids": {"$ref": "#/$defs/source_id_list"},
        "owning_tests": {"$ref": "#/$defs/string_list"},
        "drift_policy": {"$ref": "#/$defs/drift_policy"},
        "affected_profiles": {"$ref": "#/$defs/string_list"},
        "related_record_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "resolution": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "conflict"}}},
          "then": {"required": ["related_record_ids", "resolution"]}
        },
        {
          "if": {"properties": {"kind": {"const": "conflict"}}},
          "then": {
            "properties": {
              "related_record_ids": {"minItems": 2}
            }
          }
        }
      ]
    }
  }
}
