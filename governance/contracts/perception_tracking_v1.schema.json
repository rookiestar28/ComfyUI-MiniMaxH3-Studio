{
  "$id": "comfyui-h3-context://contracts/perception_tracking_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H3 visual perception tracking v1",
  "type": "object",
  "required": [
    "schema",
    "document_id",
    "status",
    "complete",
    "route",
    "identity_policy",
    "decode_document_id",
    "selected_asset_ids",
    "detections",
    "masks",
    "tracks",
    "embeddings",
    "reid_candidates",
    "receipt",
    "diagnostics"
  ],
  "properties": {
    "schema": {"const": "h3.visual.perception_tracking.v1"},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {
      "enum": ["complete", "partial", "empty", "corrupt", "unsupported", "cancelled"]
    },
    "complete": {"type": "boolean"},
    "route": {"enum": ["comfyui_native", "ollama", "specialist"]},
    "identity_policy": {"enum": ["disabled", "local_opt_in"]},
    "decode_document_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "selected_asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "detections": {"type": "array", "maxItems": 256},
    "masks": {"type": "array", "maxItems": 256},
    "tracks": {"type": "array", "maxItems": 64},
    "embeddings": {"type": "array", "maxItems": 64},
    "reid_candidates": {"type": "array", "maxItems": 256},
    "receipt": {"type": ["object", "null"]},
    "diagnostics": {"type": "array", "maxItems": 16, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
