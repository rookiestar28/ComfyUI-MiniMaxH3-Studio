{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/audio_evidence_fusion_v1.schema.json",
  "title": "H3 Audio Evidence Fusion v1",
  "type": "object",
  "required": ["schema", "document_id", "status", "candidates", "groups", "decisions", "calibration_profile", "receipt", "benchmark", "evaluation", "diagnostics"],
  "properties": {
    "schema": {"const": "h3.audio.evidence_fusion.v1"},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "status": {"enum": ["complete", "partial", "empty", "corrupt", "unsupported", "cancelled"]},
    "candidates": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/candidate"}},
    "groups": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/group"}},
    "decisions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/decision"}},
    "calibration_profile": {"$ref": "#/$defs/calibrationProfile"},
    "receipt": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
    "benchmark": {"anyOf": [{"$ref": "#/$defs/benchmark"}, {"type": "null"}]},
    "evaluation": {"anyOf": [{"$ref": "#/$defs/evaluation"}, {"type": "null"}]},
    "diagnostics": {"type": "array", "maxItems": 32, "items": {"type": "string"}}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["asset_id", "source_id", "source_fingerprint", "anchor_kind", "anchor_id"],
      "properties": {
        "asset_id": {"type": "string"},
        "source_id": {"type": "string"},
        "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "anchor_kind": {"type": ["string", "null"]},
        "anchor_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "candidateReceipt": {
      "type": "object",
      "required": ["route", "disposition", "adapter_id", "adapter_version", "model_id", "model_digest", "output_fingerprint"],
      "properties": {
        "route": {"enum": ["static_injected", "comfyui_native", "ollama", "specialist"]},
        "disposition": {"enum": ["qualified", "rejected", "unavailable", "unsupported"]},
        "adapter_id": {"type": "string"},
        "adapter_version": {"type": "string"},
        "model_id": {"type": "string"},
        "model_digest": {"$ref": "#/$defs/fingerprint"},
        "output_fingerprint": {"$ref": "#/$defs/fingerprint"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "group_id", "category", "authority", "claim", "support", "confidence", "source", "receipt", "uncertainties", "exact", "high_impact"],
      "properties": {
        "candidate_id": {"type": "string"},
        "group_id": {"type": "string"},
        "category": {"enum": ["transcript", "speaker_identity", "audio_event", "av_alignment", "reference_semantic"]},
        "authority": {"enum": ["user_authored", "observed_asr", "speaker_hypothesis", "audio_event", "av_grounding", "reference_semantic", "inferred"]},
        "claim": {"type": ["string", "null"]},
        "support": {"enum": ["supported", "uncertain", "unsupported"]},
        "confidence": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/source"},
        "receipt": {"$ref": "#/$defs/candidateReceipt"},
        "uncertainties": {"type": "array", "maxItems": 16},
        "exact": {"type": "boolean"},
        "high_impact": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["group_id", "category", "source", "candidate_ids", "resolution"],
      "properties": {
        "group_id": {"type": "string"},
        "category": {"type": "string"},
        "source": {"$ref": "#/$defs/source"},
        "candidate_ids": {"type": "array", "maxItems": 256, "items": {"type": "string"}},
        "resolution": {"enum": ["consensus", "alternatives", "conflict", "uncertain", "abstained"]}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["decision_id", "group_id", "resolution", "selected_candidate_ids", "alternative_candidate_ids", "raw_confidence", "calibrated_confidence", "abstention_reason"],
      "properties": {
        "decision_id": {"type": "string"},
        "group_id": {"type": "string"},
        "resolution": {"enum": ["consensus", "alternatives", "conflict", "uncertain", "abstained"]},
        "selected_candidate_ids": {"type": "array", "items": {"type": "string"}},
        "alternative_candidate_ids": {"type": "array", "items": {"type": "string"}},
        "raw_confidence": {"type": ["string", "null"]},
        "calibrated_confidence": {"type": ["string", "null"]},
        "abstention_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "calibrationBin": {
      "type": "object",
      "required": ["lower", "upper", "calibrated"],
      "properties": {"lower": {"type": "string"}, "upper": {"type": "string"}, "calibrated": {"type": "string"}},
      "additionalProperties": false
    },
    "calibrationProfile": {
      "type": "object",
      "required": ["schema", "profile_id", "version", "fit_case_ids", "held_out_case_ids", "bins"],
      "properties": {
        "schema": {"const": "h3.audio.evidence_fusion.v1"},
        "profile_id": {"type": "string"},
        "version": {"type": "string"},
        "fit_case_ids": {"type": "array", "items": {"type": "string"}},
        "held_out_case_ids": {"type": "array", "items": {"type": "string"}},
        "bins": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/calibrationBin"}}
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["cache_status", "cache_key_fingerprint", "memory_bytes", "wall_time_ms", "output_bytes", "output_items", "cancellation_checkpoints", "network_used", "decoder_started"],
      "properties": {
        "cache_status": {"enum": ["disabled", "not_used", "miss", "hit"]},
        "cache_key_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "memory_bytes": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "output_items": {"type": "integer", "minimum": 0},
        "cancellation_checkpoints": {"type": "integer", "minimum": 0},
        "network_used": {"type": "boolean"},
        "decoder_started": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["schema", "route", "adapter_id", "adapter_version", "output_fingerprint", "source_fingerprints", "resource"],
      "properties": {
        "schema": {"const": "h3.audio.evidence_fusion.v1"},
        "route": {"enum": ["static_injected", "comfyui_native", "ollama", "specialist", "mixed"]},
        "adapter_id": {"type": "string"},
        "adapter_version": {"type": "string"},
        "output_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "source_fingerprints": {"type": "array", "items": {"$ref": "#/$defs/fingerprint"}},
        "resource": {"$ref": "#/$defs/resource"}
      },
      "additionalProperties": false
    },
    "benchmark": {"type": "object"},
    "evaluation": {"type": "object"}
  },
  "additionalProperties": false
}
