{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfyui-h3-context://contracts/ocr_observation_v1.schema.json",
  "title": "H3 exact OCR observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document_id", "status", "complete", "selected_asset_ids", "candidates", "disagreements", "receipt", "diagnostics"],
  "properties": {
    "schema": {"const": "h3.ocr.observation.v1"},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "status": {"enum": ["complete", "abstained", "partial", "corrupt", "unsupported"]},
    "complete": {"type": "boolean"},
    "selected_asset_ids": {"type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": {"type": "string"}},
    "candidates": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/candidate"}},
    "disagreements": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/disagreement"}},
    "receipt": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
    "diagnostics": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "time": {
      "type": "object", "additionalProperties": false, "required": ["raw", "seconds"],
      "properties": {"raw": {"type": "string"}, "seconds": {"type": "string"}}
    },
    "region": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "persistence": {
      "type": "object", "additionalProperties": false, "required": ["frame_id", "start", "end"],
      "properties": {"frame_id": {"type": "string"}, "start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}}
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false, "required": ["kind", "detail", "severity"],
      "properties": {"kind": {"type": "string"}, "detail": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]}}
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "asset_id", "source_id", "text", "script", "language", "region", "polygon", "persistence", "reading_order", "orientation", "confidence", "evidence_span", "authority", "uncertainties"],
      "properties": {
        "candidate_id": {"type": "string"}, "asset_id": {"type": "string"}, "source_id": {"type": "string"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4096}, "script": {"type": "string"}, "language": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "region": {"$ref": "#/$defs/region"}, "polygon": {"type": "array", "minItems": 3, "maxItems": 32, "items": {"$ref": "#/$defs/point"}},
        "persistence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/persistence"}},
        "reading_order": {"type": "integer", "minimum": 1, "maximum": 128}, "orientation": {"type": "string"},
        "confidence": {"type": "string", "pattern": "^(0|1|0\\.[0-9]+|1\\.0+)$"}, "evidence_span": {"type": "string", "minLength": 1, "maxLength": 256},
        "authority": {"enum": ["observed", "user_required_match"]}, "uncertainties": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/uncertainty"}}
      }
    },
    "disagreement": {
      "type": "object", "additionalProperties": false, "required": ["disagreement_id", "kind", "candidate_ids", "detail", "severity", "uncertainty"],
      "properties": {"disagreement_id": {"type": "string"}, "kind": {"enum": ["engine", "required_text", "duplicate", "timing", "script_language"]}, "candidate_ids": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}}, "detail": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]}, "uncertainty": {"$ref": "#/$defs/uncertainty"}}
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["backend_family", "adapter_id", "adapter_version", "model_id", "model_digest", "parser_path", "output_fingerprint", "media_fingerprints", "device"],
      "properties": {"backend_family": {"enum": ["comfyui_native", "ollama"]}, "adapter_id": {"type": "string"}, "adapter_version": {"type": "string"}, "model_id": {"type": "string"}, "model_digest": {"type": "string"}, "parser_path": {"type": "string"}, "output_fingerprint": {"type": "string"}, "media_fingerprints": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}}, "device": {"type": "string"}}
    }
  }
}
