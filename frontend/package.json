{
  "name": "@comfyui-h3-context/frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.3.0 <12"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --config playwright.config.ts",
    "test:e2e:host": "playwright test --config playwright.host.config.ts",
    "test:e2e:hc09": "playwright test --config playwright.hc09.config.ts",
    "test:e2e:hc10": "playwright test --config playwright.hc10.config.ts",
    "test:e2e:render-and-browser": "playwright test --config playwright.render-and-browser.config.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "lightningcss": "1.33.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
