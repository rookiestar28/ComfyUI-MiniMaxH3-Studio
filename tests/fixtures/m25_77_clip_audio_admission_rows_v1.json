      "embedded_audio": "unavailable",
      "result": "invalid_contract"
    },
    {"name": "image_clip", "clip_id": "clip-image", "result": "invalid_contract"},
    {"name": "title_clip", "clip_id": "clip-title", "result": "invalid_contract"}
  ]
