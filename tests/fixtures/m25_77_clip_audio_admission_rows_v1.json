  "rows": [
    {"name": "primary_clip_with_bound_audio", "clip_id": "clip-main", "result": "accepted"},
    {
      "name": "overlay_clip_with_bound_audio",
      "clip_id": "clip-video-overlay",
      "asset_id": "vid-primary",
      "result": "accepted"
    },
    {
      "name": "video_whose_audio_the_overlay_policy_excludes",
      "clip_id": "clip-video-overlay",
      "result": "invalid_contract"
    },
    {
      "name": "video_without_audio",
      "clip_id": "clip-video-overlay",
