  "updated_at": "2026-08-07",
  "purpose": "Metadata-only synthetic fixture for split, annotation, privacy, and blinded-review governance.",
  "license_policy": {
    "review_status": "reviewed",
    "reviewed_source_refs": ["M9-03-SYNTHETIC", "M9-03-GUIDE-GOLDEN"],
    "allowed_license_classes": ["synthetic", "MIT", "Apache-2.0"],
    "forbidden_content_classes": ["unreviewed_or_prohibited", "noncommercial_without_approval"]
  },
  "privacy_policy": {
    "review_status": "reviewed",
    "portable_projection": "fingerprints_and_bounded_metadata",
    "forbidden_fields": ["raw_media", "prompt_content", "credentials", "cookies", "signed_urls", "private_paths"],
    "restricted_retention_days": 30
  },
  "review_protocol": {
    "protocol_id": "m9-03-blind-pairwise-v1",
    "method": "blinded_pairwise",
    "blind": true,
    "pairwise": true,
    "tie_allowed": true,
    "order_swap_required": true,
    "dimensions": ["hard_constraints", "subject_identity", "reference_role", "temporal_order", "camera_motion", "audio_visual", "hallucination_omission", "overall_intent"],
    "qualification": "Reviewers complete qualification anchors and use calibrated audiovisual instructions before holdout review.",
    "adjudication": "Disagreements are retained by dimension and resolved by a recorded adjudication pass after the blind comparison."
  },
  "coverage_policy": {
    "languages": ["chinese", "english", "code_switch", "multilingual"],
    "modalities": ["text", "image", "video", "audio", "reference"],
    "risk_classes": ["standard", "ambiguity", "conflict", "impossible_constraint", "adversarial", "resource", "missing_media", "malformed_media"],
    "timing_semantics": ["explicit", "implicit", "mixed"],
    "exact_text_fields": ["dialogue", "lyrics", "visible_text"],
    "rationale": {
      "pilot": "A bounded pilot identifies missing mode-language-risk cells before the frozen split.",
      "power": "Power is estimated per stratum and reported rather than replaced with a fixed case quota.",
      "variability": "Observed language, modality, timing, source-cluster, and risk variability drive expansion.",
      "budget": "Collection and review spend caps decide additions after safety and power checks.",
      "source_clusters": "Source bundles and derivation families are balanced without crossing partition boundaries."
    },
    "quota_policy": "evidence_justified_not_fixed"
  },
